#
# DontFall build configuration (stm32mp157c-dk2)
#

MACHINE ??= "stm32mp157c-dk2"
DISTRO ??= "openstlinux-weston"

PACKAGE_CLASSES ?= "package_ipk"
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"

# GPU binary packages (gcnano-userland) require accepting the ST EULA.
# Read it first: meta-st-stm32mp/conf/eula/stm32mp15-disco
#ACCEPT_EULA_stm32mp157c-dk2 = "1"

# Generate a raw sdcard image (wic) on image build
WKS_IMAGE_FSTYPES += "wic wic.bz2 wic.bmap"
WKS_FILE += "${OPTEEMIN_WIC_FILE}"

# Secure boot: sign FSBL (TF-A BL2) and FIP (OP-TEE + U-Boot) with the
# OTP-fused ECDSA key. SIGN_ENABLE also builds TF-A with
# TRUSTED_BOARD_BOOT=1 and wraps the FIP with TBB certificates.
# Both inputs live in gitignored dirs at the workspace root:
#   stm32mp15x-keys/         - key pair generated by STM32MP_KeyGen_CLI
#   stm32mp15x-signingtool/  - extracted STM32CubeProgrammer install
SIGN_ENABLE = "1"
SIGN_TOOL = "${TOPDIR}/../stm32mp15x-signingtool/STM32CubeProgrammer/bin/STM32_SigningTool_CLI"
SIGN_KEY_stm32mp15     = "${TOPDIR}/../stm32mp15x-keys/privateKey00.pem"
SIGN_KEY_PUB_stm32mp15 = "${TOPDIR}/../stm32mp15x-keys/publicKey00.pem"
# Key passphrase is read from the gitignored keys dir so no secret lands in
# this file.
SIGN_KEY_PASS = "${@open('${TOPDIR}/../stm32mp15x-keys/passphrase.txt').read().strip()}"

# Application development: clone the app repo into the workspace
# (<workspace>/dontfall-app) and uncomment to build it from your checkout
# (./deploy.sh adds these lines automatically when it finds the checkout).
#EXTERNALSRC:pn-dontfall-app = "${TOPDIR}/../dontfall-app"
#EXTERNALSRC_BUILD:pn-dontfall-app = "${TOPDIR}/../dontfall-app-build"

# WiFi auto-connect: the board joins this network on boot (wpa-supplicant
# bbappend in meta-df-common; the passphrase lands in the image as a hashed
# PSK, never plaintext). Leave unset to disable.
#DF_WIFI_SSID = "myssid"
#DF_WIFI_PASSWORD = "mypassword"   # empty = open network

# Share downloads and sstate between build directories
# (and between host and container builds - the container bind-mounts the
# workspace at the same absolute path)
DL_DIR = "${TOPDIR}/../downloads"
SSTATE_DIR = "${TOPDIR}/../sstate-cache"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"
