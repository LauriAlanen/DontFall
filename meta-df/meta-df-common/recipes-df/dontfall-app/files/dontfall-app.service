[Unit]
Description=DontFall A7 application (ROS 2 node dontfall_app, LD8 = M4 link status)
RequiresMountsFor=/usr/local

[Service]
# ROS 2 environment: library path and the ament index rclcpp loads the
# middleware from. No ROS log files: the output already goes to journald,
# and rclcpp's file logger needs a home directory a service doesn't have.
ExecStart=/bin/sh -c '. /opt/ros/jazzy/setup.sh && exec /usr/local/bin/dontfall-app --led /sys/class/leds/heartbeat --ros-args --disable-external-lib-logs'
Restart=on-failure

[Install]
WantedBy=multi-user.target
