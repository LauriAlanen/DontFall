{
  "configById": {
    "Plot!tilt": {
      "paths": [
        {
          "value": "/dontfall_m4/imu.orientation.@rpy.roll.@degrees",
          "label": "roll (deg)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/dontfall_m4/imu.orientation.@rpy.pitch.@degrees",
          "label": "pitch (deg)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "title": "Tilt",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 10
    },
    "Plot!gyro": {
      "paths": [
        {
          "value": "/dontfall_m4/imu.angular_velocity.x",
          "label": "x (rad/s)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/dontfall_m4/imu.angular_velocity.y",
          "label": "y (rad/s)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/dontfall_m4/imu.angular_velocity.z",
          "label": "z (rad/s)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "title": "Gyro",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 10
    },
    "Plot!cmd_vel": {
      "paths": [
        {
          "value": "/cmd_vel.linear.x",
          "label": "speed (m/s)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/cmd_vel.angular.z",
          "label": "turn (rad/s)",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "title": "cmd_vel (sent)",
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 10
    },
    "Indicator!armed": {
      "path": "/diagnostics.status[1].message",
      "style": "background",
      "fallbackColor": "#e0a030",
      "fallbackLabel": "DISARMED (or no data)",
      "rules": [
        {
          "operator": "=",
          "rawValue": "armed",
          "color": "#4caf50",
          "label": "ARMED"
        }
      ]
    },
    "DiagnosticSummary!m4": {
      "topicToRender": "/diagnostics",
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "sortByLevel": true
    },
    "RawMessages!diag": {
      "topicPath": "/diagnostics",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "CallService!arm": {
      "serviceName": "/dontfall_m4/arm",
      "requestPayload": "{\"data\": true}",
      "layout": "vertical",
      "buttonText": "ARM",
      "buttonTooltip": "std_srvs/SetBool on /dontfall_m4/arm",
      "buttonColor": "#4caf50",
      "editingMode": false
    },
    "CallService!disarm": {
      "serviceName": "/dontfall_m4/arm",
      "requestPayload": "{\"data\": false}",
      "layout": "vertical",
      "buttonText": "DISARM",
      "buttonTooltip": "std_srvs/SetBool on /dontfall_m4/arm",
      "buttonColor": "#d32f2f",
      "editingMode": false
    },
    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": {
        "field": "linear-x",
        "value": 0.2
      },
      "downButton": {
        "field": "linear-x",
        "value": -0.2
      },
      "leftButton": {
        "field": "angular-z",
        "value": 0.5
      },
      "rightButton": {
        "field": "angular-z",
        "value": -0.5
      }
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "splitPercentage": 62,
    "first": {
      "direction": "column",
      "first": "Plot!tilt",
      "second": {
        "direction": "column",
        "first": "Plot!gyro",
        "second": "Plot!cmd_vel"
      },
      "splitPercentage": 34
    },
    "second": {
      "direction": "column",
      "splitPercentage": 22,
      "first": {
        "direction": "row",
        "splitPercentage": 40,
        "first": "Indicator!armed",
        "second": {
          "direction": "row",
          "first": "CallService!arm",
          "second": "CallService!disarm"
        }
      },
      "second": {
        "direction": "column",
        "splitPercentage": 35,
        "first": "Teleop!drive",
        "second": {
          "direction": "column",
          "first": "DiagnosticSummary!m4",
          "second": "RawMessages!diag",
          "splitPercentage": 45
        }
      }
    }
  }
}
